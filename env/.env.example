# Copy to env/.env.dev | env/.env.staging | env/.env.production and fill in.
# These files are gitignored. NEVER commit a populated production file, and
# never put a secret (API key, keystore password, signing material) in here —
# this file is bundled into the APK and is readable by anyone who unzips it.
# Only non-secret, per-environment configuration belongs in it.

API_BASE_URL=https://api.example.com
API_TIMEOUT_MS=30000
UPLOAD_TIMEOUT_MS=180000
MAX_RETRY_COUNT=6

# Feature switches. ENABLE_RECORDING only *permits* the recording subsystem to
# run; RecordingCapabilityService still probes the device at runtime and may
# report `unsupported`. See docs/feasibility.md.
ENABLE_RECORDING=false
ENABLE_BACKGROUND_SYNC=true

# trace | debug | info | warn | error
LOG_LEVEL=info
