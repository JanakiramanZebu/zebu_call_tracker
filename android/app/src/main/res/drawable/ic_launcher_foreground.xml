<?xml version="1.0" encoding="utf-8"?>
<!-- The Zebu mark, transcribed from design/zebu_logo.svg. Drawn as a vector so
     the adaptive icon stays crisp at every launcher size and can be reused as
     the themed (monochrome) layer without a second asset.
     The group transform scales the 18.7x23.7 glyph into the 108x108 adaptive
     canvas and centres it inside the 66x66 safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.94"
        android:scaleY="1.94"
        android:translateX="35.86"
        android:translateY="21.12">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18.7,11.1 L0,5.1 L0,10.35 L12.95,14.5 L0,18.7 L0,23.95 L13.35,19.65 L18.7,17.95 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,23.95 L18.65,23.95 L18.65,28.8 L0,28.8 Z" />
    </group>
</vector>
