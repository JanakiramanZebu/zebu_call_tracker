<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS-only. Cleartext is denied for every domain, so a misconfigured base URL
  fails loudly instead of leaking call metadata and recordings over plain HTTP.

  This is the RELEASE position and it is not negotiable here. Local development
  against a plain-HTTP LAN server is handled by a same-named resource in
  `src/debug/res/xml/`, which the resource merger substitutes for this file in
  debug builds only. Do not add a debug-overrides block to this file: the tag
  cannot carry per-domain rules, and a permissive entry added here would ship.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
