<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ rules, covering both cloud backup and direct device-to-device
  transfer. Same position as backup_rules.xml: call metadata and auth tokens
  stay on the handset they were captured on.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
