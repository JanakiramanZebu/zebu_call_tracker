<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==================================================================
         PERMISSIONS
         Every entry below maps to a capability documented in
         docs/feasibility.md. Nothing here is speculative: if a permission is
         listed, a concrete subsystem requests it at runtime with a rationale
         shown to the user first (progressive requests, never all at launch).
         ================================================================== -->

    <!-- Network: metadata + recording upload, connectivity-aware sync queue. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Call state machine: ringing / offhook / idle transitions and, on
         API 30+, the number delivered with the state change. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Dual-SIM subscription + carrier attribution (API 26+). Optional: the
         app degrades to single-SIM behaviour when unavailable. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Call log reconciliation. This is the authoritative source for final
         duration/status; the live state machine only supplies early signal. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Contact-name resolution. Denial is non-fatal: contactName stays null. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Recording INGESTION, not recording capture. This app has no recording
         engine: it discovers audio the device's own dialer already wrote and
         uploads it. Reading those files goes through MediaStore, so the normal
         media permission is enough and MANAGE_EXTERNAL_STORAGE is NOT needed
         (which keeps the app out of all-files-access territory).
         Verified on SM-M356B/Android 16: /sdcard/Recordings/Call is owned by
         the dialer's uid and is not world-readable, so direct File access returns
         nothing, while the same files are fully indexed in MediaStore.Audio. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Foreground service used ONLY while an upload batch or an active
         recording is in flight — never as an always-on keepalive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Sync/upload status notifications (runtime-requested on API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Post-call overlay (Truecaller-style card after each call).
         Users grant this once via the "Display over other apps" settings page;
         we open it with ACTION_MANAGE_OVERLAY_PERMISSION. Without it the
         overlay silently does not appear — no crash, no permission dialog loop.

         This is the ONLY permission the card needs, and it does double duty:
         besides letting the window be drawn, holding it is a documented
         exemption from both the Android 12 ban on starting services from a
         background broadcast and the Android 10 background-activity-start
         restriction that the "View Details" tap would otherwise hit.

         FOREGROUND_SERVICE_PHONE_CALL used to be declared here for an overlay
         *service*. That service could never start: on API 34+ the phoneCall
         foreground type requires MANAGE_OWN_CALLS or the dialer role, neither
         of which this app has or wants. The card is a plain WindowManager view
         now, so the permission is gone with it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Reboot recovery: re-arm the call-state receiver and resume the queue.
         Handler is strictly idempotent — see docs/architecture.md. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Doze exemption. Not requested at launch and not required to run: the
         app degrades to whatever the OS allows. It is asked for once, with a
         rationale, because on this fleet's OEM builds a non-exempt app has its
         scheduled ingest deferred for hours, which defeats capturing a dialer
         recording before the dialer rotates it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- allowBackup=false is a requirement, not a default.
         This app's private storage holds the call outbox (numbers, contact
         names, timestamps) and the background worker's auth session. With
         backup left at its default of true, all of that is eligible for
         Google cloud backup and for `adb backup` off an unlocked handset —
         call records leaving the device by a route nobody asked for. The two
         rules files keep the same position on the API 31+ and legacy paths. -->
    <application
        android:label="Zebu Call Tracker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Background call detection. ACTION_PHONE_STATE_CHANGED is on the
             implicit-broadcast exemption list, so this manifest receiver still
             wakes a stopped process on Android 8+. exported="true" is required:
             the sender is the system, not this app. -->
        <receiver
            android:name=".call.CallStateReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- No overlay service is declared, deliberately. CallStateReceiver
             calls PostCallOverlayController on IDLE, which adds a
             TYPE_APPLICATION_OVERLAY view straight to WindowManager and removes
             it after 8 seconds or on a tap. A window needs no component of its
             own, and the service that used to be here was unstartable on every
             supported API level — see PostCallOverlayController's class doc. -->

        <!-- WorkManager Foreground Service for uninterrupted data sync when app is backgrounded or closed -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Persistent foreground service to prevent the OS from killing the app process
             when it is swiped away from the Recent Apps list. -->
        <service
            android:name=".background.CallTrackingService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Reboot and app-update recovery. Both broadcasts are explicit
             wake-ups for a stopped package, so exported="true" is required:
             the sender is the system. -->
        <receiver
            android:name=".background.BootReceiver"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- NetworkRecoveryReceiver is deliberately NOT registered here.
             CONNECTIVITY_CHANGE is an implicit broadcast, and manifest
             receivers stopped being delivered those in Android 7 (API 24), so
             the entry that used to sit here never fired once on any supported
             device. Network recovery now has two real mechanisms:
               - while the process is alive, the ConnectivityManager callback
                 registered by NetworkRecoveryReceiver.registerNetworkCallback,
               - while it is not, the NetworkType.CONNECTED constraint on the
                 WorkManager sync jobs, which the system releases on its own
                 once a connection exists. -->

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Battery-optimisation exemption screens. -->
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>

        <!-- OEM background-restriction managers. Package visibility on API 30+
             makes resolveActivity() return null for a component in an
             undeclared package, so without these the vendor shortcut would
             silently fall through to the generic app-info screen on exactly
             the devices that need it most. -->
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.oneplus.security" />
    </queries>
</manifest>
