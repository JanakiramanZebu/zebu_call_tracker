<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==================================================================
         PERMISSIONS
         Every entry below maps to a capability documented in
         docs/feasibility.md. Nothing here is speculative: if a permission is
         listed, a concrete subsystem requests it at runtime with a rationale
         shown to the user first (progressive requests, never all at launch).
         ================================================================== -->

    <!-- Network: metadata + recording upload, connectivity-aware sync queue. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Call state machine: ringing / offhook / idle transitions and, on
         API 30+, the number delivered with the state change. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- READ_PHONE_NUMBERS is deliberately NOT declared. It used to sit here
         for dual-SIM attribution, but the subscription list that attribution
         reads needs only READ_PHONE_STATE above; nothing ever read a line
         number, and the ICCID it might have unlocked is blank to non-carrier
         apps from API 29. -->

    <!-- Call log reconciliation. This is the authoritative source for final
         duration/status; the live state machine only supplies early signal. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Contact-name resolution. Denial is non-fatal: contactName stays null. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Recording INGESTION, not recording capture. This app has no recording
         engine: it discovers audio the device's own dialer already wrote and
         uploads it. Reading those files goes through MediaStore, so the normal
         media permission is enough and MANAGE_EXTERNAL_STORAGE is NOT needed
         (which keeps the app out of all-files-access territory).
         Verified on SM-M356B/Android 16: /sdcard/Recordings/Call is owned by
         the dialer's uid and is not world-readable, so direct File access returns
         nothing, while the same files are fully indexed in MediaStore.Audio. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Foreground services.
           - `dataSync`: WorkManager's SystemForegroundService, which runs
             expedited ingest/sync work as a foreground service below API 31
             and a long recording upload as a long-running worker on any
             API; and CallTrackingService below Android 14.
           - `specialUse`: CallTrackingService from Android 14. It runs all
             day from boot on every signed-in handset (unless the server's
             policy sets `keepalive_service` to false), which `dataSync`
             cannot: Android 15 caps it at six hours a day and forbids
             starting it from BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Sync/upload status notifications (runtime-requested on API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Post-call overlay (Truecaller-style card after each call).
         Users grant this once via the "Display over other apps" settings page;
         we open it with ACTION_MANAGE_OVERLAY_PERMISSION. Without it the
         overlay silently does not appear — no crash, no permission dialog loop.

         This is the ONLY permission the card needs, and it does double duty:
         besides letting the window be drawn, holding it is a documented
         exemption from both the Android 12 ban on starting services from a
         background broadcast and the Android 10 background-activity-start
         restriction that the "View Details" tap would otherwise hit.

         FOREGROUND_SERVICE_PHONE_CALL used to be declared here for an overlay
         *service*. That service could never start: on API 34+ the phoneCall
         foreground type requires MANAGE_OWN_CALLS or the dialer role, neither
         of which this app has or wants. The card is a plain WindowManager view
         now, so the permission is gone with it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Reboot recovery: re-arm the call-state receiver and resume the queue.
         Handler is strictly idempotent — see docs/architecture.md. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Doze exemption. Not requested at launch and not required to run: the
         app degrades to whatever the OS allows. It is asked for once, with a
         rationale, because on this fleet's OEM builds a non-exempt app has its
         scheduled ingest deferred for hours, which defeats capturing a dialer
         recording before the dialer rotates it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- allowBackup=false is a requirement, not a default.
         This app's private storage holds the call outbox (numbers, contact
         names, timestamps) and the background worker's auth session. With
         backup left at its default of true, all of that is eligible for
         Google cloud backup and for `adb backup` off an unlocked handset —
         call records leaving the device by a route nobody asked for. The two
         rules files keep the same position on the API 31+ and legacy paths. -->
    <application
        android:label="Zebu Call Tracker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Background call detection. ACTION_PHONE_STATE_CHANGED is on the
             implicit-broadcast exemption list, so this manifest receiver still
             wakes a stopped process on Android 8+. exported="true" is required:
             the sender is the system, not this app. -->
        <receiver
            android:name=".call.CallStateReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- No overlay service is declared, deliberately. CallStateReceiver
             calls PostCallOverlayController on IDLE, which adds a
             TYPE_APPLICATION_OVERLAY view straight to WindowManager and removes
             it after 8 seconds or on a tap. A window needs no component of its
             own, and the service that used to be here was unstartable on every
             supported API level — see PostCallOverlayController's class doc. -->

        <!-- WorkManager's own foreground service. Expedited work (the post-call
             ingest, "send now" syncs) runs inside it below API 31, and a sync
             promotes itself into it before a long recording upload so
             WorkManager's ten-minute limit cannot cut the transfer off. Both
             use the dataSync type declared here. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- The always-on call-tracking service. Runs on every signed-in
             handset unless the server's sync policy sets `keepalive_service`
             to false: on Xiaomi, Oppo, Vivo, OnePlus and Honor builds a closed
             app stops getting the "call ended" broadcast, and calls reached
             the CRM days late. It complements the call-state receiver, the
             content-URI triggers and the hourly WorkManager safety net.
             specialUse from Android 14, dataSync below (see the permissions
             above); the property states the use, as Android 14 requires. -->
        <service
            android:name=".background.CallTrackingService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Captures the employee's work-call log and dialer recordings after each call and delivers them to the company CRM." />
        </service>

        <!-- FCM push wake-up (Mobile API Guide §3.3). The server sends a
             data-only, high-priority SYNC_REQUEST to a phone that has gone
             quiet or is sitting on unsynced calls; this hands it to
             PushSyncWorker. Inert in a build without google-services.json:
             FirebaseApp is never initialised, so nothing is delivered here.
             No POST_NOTIFICATIONS use: the message shows nothing. -->
        <service
            android:name=".push.CallTrackMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reboot and app-update recovery. Both broadcasts are explicit
             wake-ups for a stopped package, so exported="true" is required:
             the sender is the system. -->
        <receiver
            android:name=".background.BootReceiver"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- NetworkRecoveryReceiver is deliberately NOT registered here.
             CONNECTIVITY_CHANGE is an implicit broadcast, and manifest
             receivers stopped being delivered those in Android 7 (API 24), so
             the entry that used to sit here never fired once on any supported
             device. Network recovery now has two real mechanisms:
               - while the process is alive, the default-network callback
                 registered by NetworkRecoveryReceiver.registerNetworkCallback,
                 which enqueues a sync only on a real offline-to-online
                 transition with work owed,
               - while it is not, the CONNECTED constraint on the WorkManager
                 sync jobs, which the system releases on its own once any
                 connection exists. -->

        <!-- WhatsApp call capture. Reads only WhatsApp's own call
             notifications (see WhatsAppCallListener); the user grants
             "Notification access" for it in system Settings. -->
        <service
            android:name=".whatsapp.WhatsAppCallListener"
            android:exported="true"
            android:label="Zebu Call Tracker - WhatsApp calls"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WAL for sqflite's connections, matching the native helper
             (enableWriteAheadLogging) on the same zebu_calls.sqlite file. -->
        <meta-data
            android:name="com.tekartik.sqflite.wal_enabled"
            android:value="true" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Battery-optimisation exemption screens. -->
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>

        <!-- WhatsApp call capture: whether WhatsApp is installed decides
             whether its notification-access ask is shown. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>
</manifest>
