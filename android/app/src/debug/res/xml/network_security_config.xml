<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. The resource merger substitutes this for the `src/main`
  file of the same name when assembling a debug variant; release builds never
  see it.

  It exists because the development API server is a LAN host on plain HTTP (see
  env/dev.json). With the release policy in force, every upload —
  Dio's from Dart and HttpURLConnection's from the native SyncCoordinator alike —
  fails with "CLEARTEXT communication not permitted", which presents as a
  totally broken sync pipeline rather than as the policy decision it is.

  Everything not listed stays HTTPS-only even in debug, so a typo'd production
  hostname still fails loudly.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Keep in step with API_BASE_URL in env/dev.json. A LAN server on
             any OTHER address is refused with "CLEARTEXT communication not
             permitted" — add it here as well as in env/dev.json. Android's
             network-security-config has no CIDR or wildcard form, so each
             development host has to be listed by name. -->
        <domain includeSubdomains="false">192.168.5.46</domain>
        <!-- Emulator loopback to the host machine, and adb reverse. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
