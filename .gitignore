# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------------
# Gradle build output. The generated .gitignore only covers the root /build/,
# which lets android/build/reports/ slip through.
android/build/
android/app/build/
android/.gradle/

# ---------------------------------------------------------------------------
# Call Tracker: secrets and per-environment config
# ---------------------------------------------------------------------------
# Environment files carry per-deployment base URLs, consumed by
# --dart-define-from-file. example.json and the README are the only tracked
# ones; a real deployment's URL does not belong in the repository.
env/*.json
!env/example.json

# Android release signing material.
android/key.properties
*.jks
*.keystore

# Locally captured recordings / exported call data must never enter VCS.
*.m4a
*.aac
*.amr
